---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Waypoint Not Found"
  description="The requested flight plan waypoint or page could not be located."
>
  <div class="notfound-wrapper section">
    <div class="container">
      <div class="notfound-card glass-panel">
        <span class="section-tag amber">NAV ERROR · WAYPOINT NOT FOUND</span>
        <h1 class="notfound-code mono">404</h1>
        <h2 class="notfound-title">Off Flight Plan Route</h2>
        <p class="notfound-desc">
          The waypoint or URL you are attempting to navigate to does not exist in our flight navigation database.
        </p>

        <div class="notfound-actions">
          <a href="/" class="btn btn-primary">Return to Homepage</a>
          <a href="/alphafloorefb/" class="btn btn-secondary">Explore AlphaFloor EFB</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .notfound-wrapper {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .notfound-card {
    max-width: 640px;
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .notfound-code {
    font-size: 6rem;
    font-weight: 900;
    line-height: 1;
    margin: 1.5rem 0 0.5rem 0;
    color: var(--hud-amber);
    text-shadow: 0 0 30px rgba(245, 158, 11, 0.3);
  }

  .notfound-title {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .notfound-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 480px;
    margin-bottom: 2.25rem;
  }

  .notfound-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
