---
import Layout from '../../layouts/Layout.astro';
import { getLatestRelease } from '../../utils/githubRelease';

const release = await getLatestRelease();
---

<Layout
  title="AlphaFloor EFB — Modern Electronic Flight Bag for Airbus in X-Plane 12"
  description="Modern Electronic Flight Bag for Airbus aircraft in X-Plane 12. Integrated into the 3D cockpit tablet and accessible from any iPad, tablet, or browser over local Wi-Fi. Optimized for the ToLiss Airbus fleet."
  image="/images/alphafloorefb-icon.png"
>
  <!-- Hero Section -->
  <section class="efb-hero section">
    <div class="container">
      <div class="efb-hero-badge-wrap">
        <span class="section-tag">
          <img src="/images/alphafloorefb-icon.png" alt="AlphaFloor EFB" class="hero-badge-icon" width="22" height="22" />
          <span>Airbus Electronic Flight Bag · X-Plane 12</span>
        </span>
      </div>

      <h1 class="efb-hero-title">
        The Modern Cockpit EFB for the <span class="gradient-text">ToLiss Airbus Fleet</span>
      </h1>

      <p class="efb-hero-subtitle">
        Integrated seamlessly into your 3D cockpit tablet and accessible from your iPad, Android tablet, phone, or laptop over local Wi-Fi. Features deep aircraft integration, intuitive touch controls, and zero impact on simulator framerates.
      </p>

      <div class="efb-hero-actions">
        <button id="buy-hero-btn" class="btn btn-pro btn-lg">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
          <span class="btn-label">Buy Lifetime License — 11.99€</span>
        </button>

        <a href="#download" class="btn btn-secondary btn-lg">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download Free Trial ({release.version})</span>
        </a>

        <a href="#features" class="btn btn-ghost btn-lg">
          <span>Explore Features</span>
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <a href="/alphafloorefb/docs/" class="btn btn-ghost btn-lg">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Documentation</span>
        </a>
      </div>

      <!-- Quick Aircraft Fleet Compatibility Pills -->
      <div class="fleet-strip">
        <span class="fleet-label">OPTIMIZED FLEET:</span>
        <div class="fleet-tags">
          <span class="fleet-badge">ToLiss A319</span>
          <span class="fleet-badge">ToLiss A320neo</span>
          <span class="fleet-badge">ToLiss A321 / XLR</span>
          <span class="fleet-badge">ToLiss A330-900</span>
          <span class="fleet-badge">ToLiss A340-600</span>
        </div>
      </div>

      <!-- Interactive Avionics Tablet Preview Mockup -->
      <div class="efb-tablet-frame glass-panel">
        <div class="tablet-top-bar">
          <div class="tablet-status-left">
            <span class="status-pill green">ONLINE</span>
            <span class="aircraft-type-text">A321-271NX · F-HBNX</span>
          </div>
          <div class="tablet-time mono">UTC 12:45:00 · FL340</div>
          <div class="tablet-status-right">
            <span class="status-pill cyan">Wi-Fi LAN: 192.168.1.42:8080</span>
            <span class="battery-text">100% ⚡</span>
          </div>
        </div>

        <div class="tablet-main-grid">
          <!-- Left App Navigation -->
          <div class="tablet-sidebar">
            <div class="tablet-app-item active">
              <span class="app-icon">📊</span>
              <span class="app-name">Performance</span>
            </div>
            <div class="tablet-app-item">
              <span class="app-icon">⚖️</span>
              <span class="app-name">Weight & Balance</span>
            </div>
            <div class="tablet-app-item">
              <span class="app-icon">📋</span>
              <span class="app-name">SimBrief OFP</span>
            </div>
            <div class="tablet-app-item">
              <span class="app-icon">🗺️</span>
              <span class="app-name">Moving Map</span>
            </div>
            <div class="tablet-app-item">
              <span class="app-icon">📈</span>
              <span class="app-name">Navigraph Charts</span>
            </div>
            <div class="tablet-app-item">
              <span class="app-icon">🚪</span>
              <span class="app-name">Doors & Ground</span>
            </div>
            <div class="tablet-app-item">
              <span class="app-icon">✅</span>
              <span class="app-name">Checklists</span>
            </div>
          </div>

          <!-- Active App Content (Takeoff Perf Mockup) -->
          <div class="tablet-content-view">
            <div class="app-header-row">
              <div>
                <h4 class="app-title-text">TAKEOFF PERFORMANCE CALCULATION</h4>
                <p class="app-subtitle-text">LFPG (PARIS CHARLES DE GAULLE) · RWY 26L · DRY · TOW 82.4T</p>
              </div>
              <span class="telemetry-badge green">DATAREFS SYNCED</span>
            </div>

            <div class="perf-results-grid">
              <div class="perf-box flex-box">
                <span class="perf-box-label">FLEX TEMP</span>
                <span class="perf-box-val amber mono">58°C</span>
                <span class="perf-box-sub">THRUST REDUCTION</span>
              </div>
              <div class="perf-box speed-box">
                <span class="perf-box-label">V1</span>
                <span class="perf-box-val cyan mono">142</span>
                <span class="perf-box-sub">DECISION</span>
              </div>
              <div class="perf-box speed-box">
                <span class="perf-box-label">VR</span>
                <span class="perf-box-val cyan mono">145</span>
                <span class="perf-box-sub">ROTATION</span>
              </div>
              <div class="perf-box speed-box">
                <span class="perf-box-label">V2</span>
                <span class="perf-box-val cyan mono">148</span>
                <span class="perf-box-sub">SAFETY SPEED</span>
              </div>
            </div>

            <div class="perf-config-row">
              <div class="config-pill"><span class="cfg-lbl">FLAPS:</span> <strong>CONF 1+F</strong></div>
              <div class="config-pill"><span class="cfg-lbl">THS:</span> <strong>UP 0.8</strong></div>
              <div class="config-pill"><span class="cfg-lbl">PACKS:</span> <strong>ON</strong></div>
              <div class="config-pill"><span class="cfg-lbl">ANTI-ICE:</span> <strong>OFF</strong></div>
              <div class="config-pill"><span class="cfg-lbl">REQ RUNWAY:</span> <strong>2,140 m</strong> (AVAIL: 4,215 m)</div>
            </div>

            <div class="mcdu-sync-banner">
              <span class="mcdu-icon">⚡</span>
              <span><strong>MCDU Scratchpad Sync</strong>: One-click transfers flex temp, V-speeds, and trim settings directly into the ToLiss FMGS!</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Architecture Features Section -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Dual Display Technology</span>
        <h2 class="section-title">One Plugin. Two Ways to Fly.</h2>
        <p class="section-subtitle">
          Whether you want a native 3D cockpit tablet display or an interactive touch experience on your iPad at your desk, AlphaFloor EFB delivers both simultaneously.
        </p>
      </div>

      <div class="grid-2">
        <!-- 3D Cockpit Display -->
        <div class="feature-card glass-panel">
          <div class="feature-icon cyan">
            <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="telemetry-badge cyan">IN-COCKPIT 3D DISPLAY</span>
          <h3 class="feature-title">Native 3D Cockpit Integration</h3>
          <p class="feature-desc">
            AlphaFloor EFB powers the pilot tablet screens right inside the 3D virtual cockpit. It displays crisp, high-resolution graphics and responsive controls without modifying any aircraft 3D model files.
          </p>
          <ul class="feature-bullet-list">
            <li>Ready to fly out of the box: powers on automatically when loading your airliner</li>
            <li>Intuitive in-cockpit mouse interaction with responsive buttons and sliders</li>
            <li>Crisp, high-definition text rendering optimized for VR and desktop monitors</li>
          </ul>
        </div>

        <!-- External Tablet Web App -->
        <div class="feature-card glass-panel">
          <div class="feature-icon amber">
            <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="telemetry-badge amber">EXTERNAL TABLET & BROWSER</span>
          <h3 class="feature-title">Fly with Any Tablet Over Wi-Fi</h3>
          <p class="feature-desc">
            Connect your iPad, Android tablet, phone, or second PC screen simply by opening your web browser. No App Store downloads, cables, or third-party client apps to install.
          </p>
          <ul class="feature-bullet-list">
            <li>Instant real-time synchronization between the cockpit and your tablet</li>
            <li>Responsive touch controls with pinch-to-zoom on moving maps and airport charts</li>
            <li>100% private and local: runs entirely across your home Wi-Fi network</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Comprehensive EFB Apps Breakdown -->
  <section class="section apps-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag green">Modular Avionics Suite</span>
        <h2 class="section-title">Everything an Airbus Captain Needs</h2>
        <p class="section-subtitle">
          Engineered to match real airline fly-by-wire Electronic Flight Bags with deep dataref interaction.
        </p>
      </div>

      <div class="grid-3">
        <!-- App 1: Takeoff & Landing Perf -->
        <div class="app-card glass-panel">
          <div class="app-card-icon">⚡</div>
          <h3 class="app-card-title">Takeoff & Landing Performance</h3>
          <p class="app-card-desc">
            Accurate Airbus performance calculation engines. Computes optimal flexible temperature, flap configuration (CONF 1+F / CONF 2 / CONF 3), V1, VR, V2 speeds, and required stopping distance based on runway condition, wind, slope, and temperature.
          </p>
          <span class="app-card-tag">FMGS MCDU Scratchpad Sync</span>
        </div>

        <!-- App 2: Weight & Balance -->
        <div class="app-card glass-panel">
          <div class="app-card-icon">⚖️</div>
          <h3 class="app-card-title">Weight, Balance & CG Envelope</h3>
          <p class="app-card-desc">
            Interactive visual cabin layout and cargo hold visualizer. Real-time Center of Gravity (% MAC) calculations with an interactive dynamic envelope diagram showing Zero Fuel Weight CG and Takeoff Weight CG limits.
          </p>
          <span class="app-card-tag">Direct ToLiss Payload Injection</span>
        </div>

        <!-- App 3: SimBrief OFP -->
        <div class="app-card glass-panel">
          <div class="app-card-icon">📋</div>
          <h3 class="app-card-title">SimBrief OFP Dispatch Viewer</h3>
          <p class="app-card-desc">
            Fetch your latest SimBrief Operational Flight Plan with a single click. Browse routes, waypoint wind components, alternate airports, contingency fuels, step climbs, and passenger loadsheets in a clean, legible format.
          </p>
          <span class="app-card-tag">One-Click Dispatch Import</span>
        </div>

        <!-- App 4: Moving Map -->
        <div class="app-card glass-panel">
          <div class="app-card-icon">🗺️</div>
          <h3 class="app-card-title">Interactive Moving Map</h3>
          <p class="app-card-desc">
            High-resolution moving map with live aircraft position, heading vector, flight plan route line, airport runway layouts, and taxiway diagrams. Smooth 60 FPS panning with touch gestures.
          </p>
          <span class="app-card-tag">Taxi & Flight Path Tracking</span>
        </div>

        <!-- App 5: Charts & PDF Viewer -->
        <div class="app-card glass-panel">
          <div class="app-card-icon">📈</div>
          <h3 class="app-card-title">Navigraph & PDF Documents</h3>
          <p class="app-card-desc">
            Seamless Navigraph Charts integration with automatic departure, arrival, and approach procedure matching. Built-in high-performance PDF engine to read company manuals, SOPs, and airport charts.
          </p>
          <span class="app-card-tag">Navigraph & Custom PDF Support</span>
        </div>

        <!-- App 6: Aircraft Controls & Checklists -->
        <div class="app-card glass-panel">
          <div class="app-card-icon">🚪</div>
          <h3 class="app-card-title">Ground Services & SOP Checklists</h3>
          <p class="app-card-desc">
            Control passenger doors, cargo doors, ground power units (GPU), high-pressure air, wheel chocks, and fueling directly from the tablet. Includes interactive normal and abnormal Airbus checklists.
          </p>
          <span class="app-card-tag">Ground Services & Airbus SOPs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section" id="compare">
    <div class="container">
      <div class="section-header">
        <span class="section-tag amber">Comparison Matrix</span>
        <h2 class="section-title">Standard Sim Setup vs AlphaFloor EFB</h2>
        <p class="section-subtitle">
          See why AlphaFloor EFB is the ultimate upgrade for your X-Plane 12 airliner cockpit.
        </p>
      </div>

      <div class="comparison-wrapper glass-panel">
        <table class="comparison-table">
          <thead>
            <tr>
              <th class="feature-col">Feature</th>
              <th class="standard-col">Standard Setup</th>
              <th class="alphafloor-col">AlphaFloor EFB</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>3D Virtual Cockpit Tablet Display</td>
              <td><span class="check-partial">~</span> Basic text / limited</td>
              <td><span class="check-yes highlight">✓</span> Full glassmorphic Airbus interface</td>
            </tr>
            <tr>
              <td>External Tablet Support (iPad / Android / Phone)</td>
              <td><span class="check-no">✕</span> Separate window only / 3rd-party tool</td>
              <td><span class="check-yes highlight">✓</span> Instant browser access over home Wi-Fi</td>
            </tr>
            <tr>
              <td>Deep ToLiss Fleet Integration</td>
              <td><span class="check-no">✕</span> Manual typing in FMGS</td>
              <td><span class="check-yes highlight">✓</span> 1-Click scratchpad sync, fuel, doors, payload</td>
            </tr>
            <tr>
              <td>Takeoff & Landing Performance Calculators</td>
              <td><span class="check-no">✕</span> External calculators / tables</td>
              <td><span class="check-yes highlight">✓</span> Built-in flex temp, V-speeds & stopping limits</td>
            </tr>
            <tr>
              <td>Visual Weight & Balance with Dynamic CG</td>
              <td><span class="check-no">✕</span> Static text menus</td>
              <td><span class="check-yes highlight">✓</span> Interactive cabin seating & dynamic CG envelope</td>
            </tr>
            <tr>
              <td>SimBrief Flight Plan Integration</td>
              <td><span class="check-partial">~</span> Raw text / manual entry</td>
              <td><span class="check-yes highlight">✓</span> Rich interactive OFP with route map & stats</td>
            </tr>
            <tr>
              <td>Interactive Airbus SOP Checklists</td>
              <td><span class="check-partial">~</span> Paper or static PDF</td>
              <td><span class="check-yes highlight">✓</span> Interactive checkable items with smart state</td>
            </tr>
            <tr>
              <td>Navigraph & Airport Charts</td>
              <td><span class="check-partial">~</span> Alt-tabbing to desktop</td>
              <td><span class="check-yes highlight">✓</span> In-cockpit & on tablet with pinch-to-zoom</td>
            </tr>
            <tr>
              <td>Framerate Impact</td>
              <td><span class="check-partial">~</span> Variable</td>
              <td><span class="check-yes highlight">✓</span> Zero micro-stutters, fluid 60 FPS display</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-header">
        <span class="section-tag green">Simple, Transparent Pricing</span>
        <h2 class="section-title">Try Free. Own for 11.99€.</h2>
        <p class="section-subtitle">
          No recurring subscription fees. Full access during your 7-day free trial. A single one-time payment for lifetime access on up to 3 machines.
        </p>
      </div>

      <div class="pricing-grid">
        <!-- 7-Day Free Trial Card -->
        <div class="pricing-card glass-panel">
          <div class="plan-header">
            <h3 class="plan-name">7-Day Free Trial</h3>
            <p class="plan-tagline">Test every single feature in your simulator risk-free</p>
            <div class="plan-price-row">
              <span class="price-val">Free</span>
              <span class="price-cycle">7 Days Full Access</span>
            </div>
          </div>

          <ul class="plan-perks">
            <li>
              <span class="perk-icon">✓</span>
              <span>All EFB modular apps unlocked</span>
            </li>
            <li>
              <span class="perk-icon">✓</span>
              <span>Simultaneous 3D cockpit & external tablet access</span>
            </li>
            <li>
              <span class="perk-icon">✓</span>
              <span>Full ToLiss fleet support (A319, A320, A321, A330, A340)</span>
            </li>
            <li>
              <span class="perk-icon">✓</span>
              <span>SimBrief & Navigraph charts integration</span>
            </li>
            <li>
              <span class="perk-icon">✓</span>
              <span>Instant in-app trial start (no credit card required)</span>
            </li>
          </ul>

          <div class="plan-cta-wrapper">
            <a href="#install" class="btn btn-secondary btn-block">
              <span>Download Plugin & Start Trial</span>
            </a>
            <span class="cta-note">Start your trial directly inside the plugin on your computer</span>
          </div>
        </div>

        <!-- Lifetime Pro License Card -->
        <div class="pricing-card glass-panel pro-card">
          <div class="popular-ribbon">LIFETIME LICENSE</div>

          <div class="plan-header">
            <div class="plan-badge-row">
              <h3 class="plan-name pro">Lifetime License</h3>
              <span class="badge-lifetime">One-time purchase</span>
            </div>
            <p class="plan-tagline">Full license for your home flight simulator setup</p>
            <div class="plan-price-row">
              <span class="price-val pro">11.99€</span>
              <span class="price-cycle">One-Time · No Subscriptions</span>
            </div>
          </div>

          <ul class="plan-perks">
            <li>
              <span class="perk-icon pro">★</span>
              <strong>Everything in the trial, plus:</strong>
            </li>
            <li>
              <span class="perk-icon pro">✓</span>
              <span><strong>Up to 3 machines</strong> per license (Mac, Windows, Linux)</span>
            </li>
            <li>
              <span class="perk-icon pro">✓</span>
              <span><strong>Instant automated activation</strong> and license key delivery</span>
            </li>
            <li>
              <span class="perk-icon pro">✓</span>
              <span><strong>Downloadable license file (<code class="code-token">AlphaFloorEFB.lic</code>)</strong> for easy drag-and-drop activation</span>
            </li>
            <li>
              <span class="perk-icon pro">✓</span>
              <span><strong>All updates included</strong> within version 1.x</span>
            </li>
            <li>
              <span class="perk-icon pro">✓</span>
              <span><strong>Reliable offline validation</strong> — fly anywhere without internet required</span>
            </li>
            <li>
              <span class="perk-icon pro">✓</span>
              <span><strong>14-day refund policy</strong> for technical defects</span>
            </li>
          </ul>

          <div class="plan-cta-wrapper">
            <button id="buy-pricing-btn" class="btn btn-pro btn-block btn-lg">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
              <span class="btn-label">Buy Lifetime License — 11.99€</span>
            </button>
            <span class="cta-note">Secure payment via Stripe · Instant key delivery</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- License Terms & Multi-Device Policy Section -->
  <section class="section license-terms-section" id="license-terms">
    <div class="container">
      <div class="license-terms-card glass-panel">
        <header class="terms-card-header">
          <span class="section-tag amber">Terms of Sale & Licensing</span>
          <h2 class="terms-card-title">AlphaFloor EFB License Terms</h2>
          <p class="terms-card-subtitle">Transparent rules designed to respect your hardware and privacy.</p>
        </header>

        <div class="terms-grid">
          <div class="terms-item">
            <h4 class="terms-heading">1. Multi-Machine Activation (Up to 3 Devices)</h4>
            <p>
              Your 11.99€ purchase entitles you to activate the software concurrently on up to <strong>three (3) personal computers</strong> (desktop PC, laptop, or Mac) owned and operated by the same pilot. External tablets connected over Wi-Fi do not consume machine activations.
            </p>
          </div>

          <div class="terms-item">
            <h4 class="terms-heading">2. Exportable License Key File (<code class="code-token">AlphaFloorEFB.lic</code>)</h4>
            <p>
              Upon purchase, you immediately receive a license key string and can download your standalone <code class="code-token">AlphaFloorEFB.lic</code> file. Simply place this file into the plugin directory on your other computers for effortless automatic activation.
            </p>
          </div>

          <div class="terms-item">
            <h4 class="terms-heading">3. Offline License Verification</h4>
            <p>
              Once activated, AlphaFloor EFB validates your license completely offline on your computer. You never need an ongoing internet connection while you are in flight.
            </p>
          </div>

          <div class="terms-item">
            <h4 class="terms-heading">4. Updates & 14-Day Refund Guarantee</h4>
            <p>
              Your purchase includes all minor and major updates within the 1.x release cycle. If you encounter technical defects or hardware incompatibilities that cannot be resolved within 14 calendar days, contact support for a full refund.
            </p>
          </div>
        </div>

        <div class="terms-footer-link">
          <a href="/terms" class="btn btn-secondary btn-sm">Read Complete Studio EULA & Terms of Sale</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Download & Latest Release Section with Changelog -->
  <section class="section download-section" id="download">
    <div class="container">
      <div class="section-header">
        <span class="section-tag green">Available Now</span>
        <h2 class="section-title">Download & Latest Release</h2>
        <p class="section-subtitle">
