<script>
  // Client-side checkout initiation logic
  const WORKER_CHECKOUT_ENDPOINT = 'https://cyberpatate-license.cyberpatate.workers.dev/api/v1/alphafloorefb/checkout/create-session';

  async function handleCheckout(buttonElement: HTMLButtonElement | null) {
    if (!buttonElement) return;
    const labelSpan = buttonElement.querySelector('.btn-label') as HTMLElement;
    const originalText = labelSpan ? labelSpan.textContent : '';

    try {
      buttonElement.disabled = true;
      if (labelSpan) labelSpan.textContent = 'Opening Secure Stripe Checkout...';

      const response = await fetch(WORKER_CHECKOUT_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      });

      if (!response.ok) {
        throw new Error(`HTTP error ${response.status}`);
      }

      const data = await response.json();
      if (data.checkoutUrl) {
        window.location.href = data.checkoutUrl;
      } else {
        throw new Error('No checkout URL returned by licensing worker');
      }
    } catch (err: any) {
      console.error('Checkout error:', err);
      alert('Failed to connect to checkout service. Please try again or email contact@cyberpatate.fr.');
      if (labelSpan && originalText) labelSpan.textContent = originalText;
      buttonElement.disabled = false;
    }
  }

  document.getElementById('buy-hero-btn')?.addEventListener('click', (e) => {
    handleCheckout(e.currentTarget as HTMLButtonElement);
  });

  document.getElementById('buy-pricing-btn')?.addEventListener('click', (e) => {
    handleCheckout(e.currentTarget as HTMLButtonElement);
  });

  // Progressive enhancement: query GitHub Releases API in background for live updates
  async function checkLiveRelease() {
    try {
      const res = await fetch('https://api.github.com/repos/CyberPatate/cyberpatate.github.io/releases?per_page=20');
      if (!res.ok) return;
      const releases = await res.json();
      if (!Array.isArray(releases) || releases.length === 0) return;

      const data = releases.find((r: any) => 
        typeof r.tag_name === 'string' && r.tag_name.startsWith('alphafloorefb-')
      ) || releases[0];
      if (!data || !data.tag_name) return;

      const rawTag = data.tag_name;
      const ver = rawTag.startsWith('alphafloorefb-') ? rawTag.slice('alphafloorefb-'.length) : rawTag;
      const zipAsset = data.assets && data.assets.find((a: any) => typeof a.name === 'string' && a.name.endsWith('.zip'));
      const verText = document.getElementById('release-version-text');
      const verLabel = document.getElementById('download-ver-label');
      const dlBtn = document.getElementById('download-plugin-btn') as HTMLAnchorElement | null;
      const sizeLabel = document.getElementById('download-size-label');

      if (verText) verText.textContent = ver;
      if (verLabel) verLabel.textContent = `(${ver})`;
      if (dlBtn && zipAsset && zipAsset.browser_download_url) {
        dlBtn.href = zipAsset.browser_download_url;
      }
      if (sizeLabel && zipAsset && zipAsset.size) {
        const mb = (zipAsset.size / (1024 * 1024)).toFixed(1);
        sizeLabel.textContent = `${mb} MB`;
      }
    } catch {
      // Quietly keep build-time values
    }
  }

  checkLiveRelease();
</script>
