---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="CyberPatate — Precision Flight Simulation Software & Tools"
  description="CyberPatate is an independent development studio crafting high-performance flight simulation tools, including AlphaFloor EFB for X-Plane 12 Airbus fleet and XLauncher."
>
  <!-- Studio Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-content">
        <div class="section-tag">
          <span class="live-dot"></span>
          <span>Simulation & Flight Deck Software</span>
        </div>

        <h1 class="hero-title">
          Crafting Precision Tools for <span class="gradient-text">Virtual Flight</span>
        </h1>

        <p class="hero-subtitle">
          CyberPatate designs high-performance flight simulation software, cockpit utilities, and avionics add-ons for X-Plane 12. Built for maximum immersion, smooth framerates, and effortless pilot workflows.
        </p>

        <div class="hero-cta-group">
          <a href="/alphafloorefb/" class="btn btn-primary btn-lg">
            <span>Explore AlphaFloor EFB</span>
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="https://xlauncher.app" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
            <span>Visit XLauncher.app</span>
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Telemetry Pill Indicators -->
        <div class="telemetry-bar">
          <div class="telemetry-item">
            <span class="telemetry-label">PERFORMANCE</span>
            <span class="telemetry-badge cyan">Fluid & Lightweight</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">SIMULATOR</span>
            <span class="telemetry-badge green">X-Plane 12 Native</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">LICENSING</span>
            <span class="telemetry-badge amber">3 Devices · No Subscriptions</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">PRIVACY</span>
            <span class="telemetry-badge green">Local LAN Processing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="section" id="products">
    <div class="container">
      <div class="section-header">
        <span class="section-tag amber">Flagship Projects</span>
        <h2 class="section-title">Designed for Serious Simmers</h2>
        <p class="section-subtitle">
          From full 3D cockpit electronic flight bags to macOS management and live network streaming.
        </p>
      </div>

      <div class="grid-2 products-grid">
        <!-- AlphaFloor EFB Card -->
        <div class="product-card glass-panel highlight-alphafloor">
          <div class="product-badge-row">
            <span class="product-type-badge efb">NEW RELEASE · EFB PLUGIN</span>
            <span class="product-price-pill">11.99€ · Lifetime</span>
          </div>

          <div class="product-header">
            <div class="product-icon-wrap">
              <img src="/images/alphafloorefb-icon.svg" alt="AlphaFloor EFB Icon" width="48" height="48" />
            </div>
            <div>
              <h3 class="product-name">AlphaFloor EFB</h3>
              <p class="product-aircraft">For ToLiss Fleet: A319, A320, A321, A330-900 & A340-600</p>
            </div>
          </div>

          <p class="product-desc">
            The modern, modular Electronic Flight Bag for Airbus aircraft in X-Plane 12. Seamlessly integrated into the 3D cockpit tablet display while simultaneously connecting to your iPad, Android tablet, or laptop over your home Wi-Fi.
          </p>

          <ul class="product-features">
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>Dual Display Engine</strong>: 3D cockpit tablet + browser web app over Wi-Fi</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>Deep ToLiss Integration</strong>: Scratchpad sync, fuel, doors & ground equipment</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>Weight & Balance</strong>: Visual cabin map & dynamic CG envelope</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>Performance Calculators</strong>: Airbus flex temp, V-speeds & landing distances</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>SimBrief & Navigraph</strong>: Live OFP import, charts & interactive checklists</span>
            </li>
          </ul>

          <div class="product-footer">
            <div class="product-license-note">
              <span>Includes 7-day free trial · Node-locked to up to 3 machines</span>
            </div>
            <a href="/alphafloorefb/" class="btn btn-primary btn-block">
              <span>View Features, Pricing & Terms</span>
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- XLauncher Pro Card -->
        <div class="product-card glass-panel highlight-xlauncher">
          <div class="product-badge-row">
            <span class="product-type-badge xlauncher">MACOS MANAGER</span>
            <span class="product-price-pill">Free Core · 5€ Pro</span>
          </div>

          <div class="product-header">
            <div class="product-icon-wrap">
              <img src="/images/xlauncher-icon.png" alt="XLauncher Icon" width="48" height="48" />
            </div>
            <div>
              <h3 class="product-name">XLauncher</h3>
              <p class="product-aircraft">Flight Deck Manager & Live Telemetry for macOS</p>
            </div>
          </div>

          <p class="product-desc">
            Native macOS add-on manager, multi-drive storage pools, real-time live telemetry streaming, automated flight logbook, landing analytics, VATSIM & IVAO network coverage, and SimBrief automated flight dispatch for X-Plane 12.
          </p>

          <ul class="product-features">
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>Multi-Drive Storage Pools</strong>: Safe symlink management across SSDs</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>Real-Time Live Telemetry</strong>: Real-time airspeed, pitch, bank & flight path</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>11-Stage Flight Phase State Machine</strong>: Fully automatic phase detection</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>Automated Logbook & Landing Analytics</strong>: Touchdown rate (fpm) & G-force</span>
            </li>
            <li>
              <span class="perk-bullet">✓</span>
              <span><strong>VATSIM & IVAO Live Radar</strong>: Live online network traffic & controller map</span>
            </li>
          </ul>

          <div class="product-footer">
            <div class="product-license-note">
              <span>Core manager is Free & Open Source · Pro is a 5€ one-time purchase</span>
            </div>
            <a href="https://xlauncher.app" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-block">
              <span>Visit xlauncher.app</span>
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Studio Values / Philosophy -->
  <section class="section values-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag green">Philosophy</span>
        <h2 class="section-title">Built the Right Way</h2>
        <p class="section-subtitle">
          Our core engineering values ensure your simulation experience remains fluid, private, and hassle-free.
        </p>
      </div>

      <div class="grid-3">
        <div class="value-card glass-panel">
          <div class="value-icon cyan">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="value-title">Zero Framerate Impact</h3>
          <p class="value-desc">
            Engineered for high-refresh rates and ultra-smooth performance. Heavy calculations, route parsing, and tablet communications run silently in the background without affecting your flight simulator's framerate.
          </p>
        </div>

        <div class="value-card glass-panel">
          <div class="value-icon amber">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="value-title">Fair, Transparent Licenses</h3>
          <p class="value-desc">
            No recurring subscription traps. Our commercial add-ons are one-time lifetime purchases that allow installation on up to 3 personal machines with offline cryptographic key verification.
          </p>
        </div>

        <div class="value-card glass-panel">
          <div class="value-icon green">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="value-title">Local-First & Private</h3>
          <p class="value-desc">
            Your flight data and cockpit interactions stay strictly on your local network. External tablets connect directly to your PC without third-party servers intermediary.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About the Studio Section -->
  <section class="section" id="about">
    <div class="container">
      <div class="about-card glass-panel">
        <div class="about-grid">
          <div class="about-visual">
            <img src="/images/cyberpatate-logo.png" alt="CyberPatate Studio" class="about-logo" />
            <div class="about-badge">
              <span>CyberPatate Studio</span>
            </div>
          </div>

          <div class="about-content">
            <span class="section-tag purple">About the Studio</span>
            <h2 class="about-title">A Passion for Aviation & Simulation Craftsmanship</h2>
            <p>
              <strong>CyberPatate</strong> is an independent flight simulation and software studio. Driven by a deep passion for aviation, virtual flight operations, and refined user experience, the studio specializes in precision tools that enhance the virtual cockpit.
            </p>
            <p>
              We focus on building rock-solid, elegant tools that bridge the gap between complex simulator datarefs and the pilot. Whether you're managing a massive library of sceneries on your Mac or flying a challenging CAT III approach with AlphaFloor EFB on your iPad, our goal is to deliver an uncompromising simulation experience.
            </p>
            <div class="about-actions">
              <a href="mailto:contact@cyberpatate.fr" class="btn btn-secondary">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>contact@cyberpatate.fr</span>
              </a>
              <a href="https://github.com/CyberPatate" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <span>View on GitHub</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 7rem 0 5rem 0;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--hud-cyan);
    box-shadow: 0 0 10px var(--hud-cyan);
  }

  .hero-title {
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .telemetry-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 1.25rem 2rem;
    background: rgba(13, 18, 31, 0.65);
    border: 1px solid rgba(56, 189, 248, 0.15);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
  }

  .telemetry-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .telemetry-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  /* Product Cards */
  .products-grid {
    align-items: stretch;
  }

  .product-card {
    padding: 2.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .highlight-alphafloor {
    border-color: rgba(56, 189, 248, 0.3);
    background: linear-gradient(180deg, rgba(16, 25, 45, 0.85) 0%, rgba(10, 15, 28, 0.8) 100%);
  }

  .highlight-alphafloor:hover {
    border-color: rgba(56, 189, 248, 0.5);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.8), 0 0 35px rgba(56, 189, 248, 0.15);
  }

  .highlight-xlauncher {
    border-color: rgba(245, 158, 11, 0.25);
    background: linear-gradient(180deg, rgba(25, 28, 40, 0.85) 0%, rgba(13, 16, 26, 0.8) 100%);
  }

  .highlight-xlauncher:hover {
    border-color: rgba(245, 158, 11, 0.45);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.8), 0 0 35px rgba(245, 158, 11, 0.12);
  }

  .product-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .product-type-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .product-type-badge.efb {
    color: var(--hud-cyan);
    background: var(--hud-cyan-dim);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .product-type-badge.xlauncher {
    color: var(--hud-amber);
    background: var(--hud-amber-dim);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .product-price-pill {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .product-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .product-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .product-name {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }

  .product-aircraft {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .product-desc {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .product-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .product-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .product-features li strong {
    color: var(--text-primary);
  }

  .perk-bullet {
    color: var(--hud-cyan);
    font-weight: 700;
  }

  .highlight-xlauncher .perk-bullet {
    color: var(--hud-amber);
  }

  .product-footer {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .product-license-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* Values Cards */
  .value-card {
    padding: 2.25rem;
  }

  .value-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .value-icon.cyan {
    background: var(--hud-cyan-dim);
    color: var(--hud-cyan);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .value-icon.amber {
    background: var(--hud-amber-dim);
    color: var(--hud-amber);
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .value-icon.green {
    background: var(--hud-green-dim);
    color: var(--hud-green);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .value-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .value-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* About Card */
  .about-card {
    padding: 3.5rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .about-logo {
    width: 180px;
    height: 180px;
    object-fit: contain;
    border-radius: var(--radius-lg);
    filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.6));
  }

  .about-badge {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .about-title {
    font-size: 2rem;
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .about-content p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .about-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }

    .about-actions {
      justify-content: center;
    }

    .about-card {
      padding: 2.25rem 1.5rem;
    }
  }
</style>
