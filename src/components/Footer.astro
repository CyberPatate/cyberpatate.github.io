---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Mission -->
      <div class="footer-brand-col">
        <a href="/" class="footer-brand">
          <img src="/images/cyberpatate-logo.png" alt="CyberPatate" class="footer-logo" width="36" height="36" />
          <span class="footer-brand-name">CyberPatate</span>
        </a>
        <p class="footer-desc">
          Independent game and flight simulation development studio crafting precision tools, avionics add-ons, and high-performance software.
        </p>
        <div class="footer-socials">
          <a href="https://github.com/CyberPatate" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation Columns -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Products</h4>
        <ul class="footer-nav">
          <li><a href="/alphafloorefb/">AlphaFloor EFB</a></li>
          <li><a href="/alphafloorefb/#pricing">AlphaFloor Pricing (11.99€)</a></li>
          <li><a href="/alphafloorefb/#features">AlphaFloor Features</a></li>
          <li><a href="https://xlauncher.app" target="_blank" rel="noopener noreferrer">XLauncher for macOS</a></li>
          <li><a href="https://xlauncher.app/#pro" target="_blank" rel="noopener noreferrer">XLauncher Pro (5€)</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h4 class="footer-heading">Studio & Support</h4>
        <ul class="footer-nav">
          <li><a href="/#about">About CyberPatate</a></li>
          <li><a href="mailto:contact@cyberpatate.fr">contact@cyberpatate.fr</a></li>
          <li><a href="https://github.com/CyberPatate" target="_blank" rel="noopener noreferrer">CyberPatate GitHub</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h4 class="footer-heading">Legal</h4>
        <ul class="footer-nav">
          <li><a href="/terms">Terms of Sale & EULA</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/alphafloorefb/#license-terms">Multi-Device License Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="footer-bottom">
      <p class="trademark-note">
        <strong>Disclaimer</strong>: <em>X-Plane</em> is a registered trademark of Laminar Research. <em>Airbus</em>, <em>A319</em>, <em>A320</em>, <em>A321</em>, <em>A330</em>, and <em>A340</em> are trademarks or registered trademarks of Airbus. <em>ToLiss</em> is a trademark of ToLiss Inc. <em>Navigraph</em> is a registered trademark of Navigraph / Arts & Technology Group HB. <em>VATSIM</em> is a trademark of VATSIM Inc. <em>IVAO</em> is a trademark of the International Virtual Aviation Organisation VZW. CyberPatate and its software products (including AlphaFloor EFB and XLauncher) are independent developments and are not affiliated with, sponsored by, or endorsed by Laminar Research, Airbus, ToLiss, Navigraph, VATSIM, or IVAO.
      </p>
      <div class="copyright-row">
        <span>© {currentYear} CyberPatate. All rights reserved.</span>
        <span>Hosted with high-availability Edge CDN.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #05070d;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 5rem 0 3rem 0;
    font-size: 0.92rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .footer-brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .footer-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 320px;
    margin-bottom: 1.5rem;
  }

  .social-link {
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    display: inline-flex;
  }

  .social-link:hover {
    color: var(--text-primary);
  }

  .footer-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .footer-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover {
    color: var(--hud-cyan);
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .trademark-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .copyright-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
