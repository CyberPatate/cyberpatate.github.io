---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isEfbDocsActive = currentPath.startsWith('/alphafloorefb/docs');
const isEfbActive = (currentPath === '/alphafloorefb/' || currentPath === '/alphafloorefb') && !isEfbDocsActive;
const isProductsActive = isEfbActive || (currentPath.startsWith('/alphafloorefb/checkout') && !isEfbDocsActive);
const isDocsActive = isEfbDocsActive;
---

<header class="navbar-wrapper">
  <div class="container">
    <nav class="navbar" aria-label="Main Navigation">
      <a href="/" class="brand" aria-label="CyberPatate Home">
        <img src="/images/cyberpatate-logo.png" alt="CyberPatate Studio" class="brand-logo" width="36" height="36" />
        <div class="brand-text">
          <span class="brand-name">CyberPatate</span>
          <span class="brand-badge">Studio</span>
        </div>
      </a>

      <div class="nav-links">
        <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a>

        <!-- Products Dropdown -->
        <div class="nav-dropdown" data-dropdown="products">
          <button 
            type="button" 
            class={`dropdown-trigger ${isProductsActive ? 'active' : ''}`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Products</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="dropdown-menu" role="menu">
            <a 
              href="/alphafloorefb/" 
              class={`dropdown-item ${isEfbActive ? 'active' : ''}`}
              role="menuitem"
            >
              <span>AlphaFloor EFB</span>
            </a>
            <a 
              href="https://xlauncher.app" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="dropdown-item"
              role="menuitem"
            >
              <span>XLauncher</span>
              <svg class="external-icon" width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Documentation Dropdown -->
        <div class="nav-dropdown" data-dropdown="docs">
          <button 
            type="button" 
            class={`dropdown-trigger ${isDocsActive ? 'active' : ''}`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Documentation</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="dropdown-menu" role="menu">
            <a 
              href="/alphafloorefb/docs/" 
              class={`dropdown-item ${isDocsActive ? 'active' : ''}`}
              role="menuitem"
            >
              <span>AlphaFloor EFB</span>
            </a>
            <a 
              href="https://xlauncher.readthedocs.io/en/v2.2.0/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="dropdown-item"
              role="menuitem"
            >
              <span>XLauncher</span>
              <svg class="external-icon" width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <a href="/#about" class="nav-link">About</a>
      </div>

      <div class="nav-actions">
        <a 
          href="https://github.com/CyberPatate" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="github-link"
          aria-label="CyberPatate on GitHub"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      </div>

      <button class="mobile-toggle" aria-label="Toggle navigation menu" id="mobile-toggle">
        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <a href="/" class={`mobile-link ${currentPath === '/' ? 'active' : ''}`}>Home</a>

    <div class={`mobile-group ${isProductsActive ? 'open' : ''}`}>
      <button class="mobile-group-toggle" type="button" aria-expanded={isProductsActive ? 'true' : 'false'}>
        <span>Products</span>
        <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="mobile-group-items">
        <a href="/alphafloorefb/" class={`mobile-sublink ${isEfbActive ? 'active' : ''}`}>
          AlphaFloor EFB
        </a>
        <a href="https://xlauncher.app" target="_blank" rel="noopener noreferrer" class="mobile-sublink">
          <span>XLauncher</span>
          <svg class="external-icon" width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <div class={`mobile-group ${isDocsActive ? 'open' : ''}`}>
      <button class="mobile-group-toggle" type="button" aria-expanded={isDocsActive ? 'true' : 'false'}>
        <span>Documentation</span>
        <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="mobile-group-items">
        <a href="/alphafloorefb/docs/" class={`mobile-sublink ${isDocsActive ? 'active' : ''}`}>
          AlphaFloor EFB
        </a>
        <a href="https://xlauncher.readthedocs.io/en/v2.2.0/" target="_blank" rel="noopener noreferrer" class="mobile-sublink">
          <span>XLauncher</span>
          <svg class="external-icon" width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <a href="/#about" class="mobile-link">About the Studio</a>

    <div class="mobile-buttons">
      <a href="/alphafloorefb/" class="btn btn-primary">Discover AlphaFloor EFB</a>
      <a href="https://xlauncher.app" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Visit XLauncher.app</a>
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(8, 11, 18, 0.78);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(56, 189, 248, 0.12);
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }

  .brand-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.6));
  }

  .brand-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-name {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }

  .brand-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--hud-cyan);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color var(--transition-fast);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-primary);
  }

  .nav-link.active {
    font-weight: 600;
    color: var(--hud-cyan);
  }

  /* Desktop Dropdowns */
  .nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .dropdown-trigger {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    padding: 0.5rem 0;
    transition: color var(--transition-fast);
  }

  .dropdown-trigger:hover,
  .dropdown-trigger.active,
  .nav-dropdown:hover .dropdown-trigger,
  .nav-dropdown.is-open .dropdown-trigger {
    color: var(--text-primary);
  }

  .dropdown-trigger.active {
    font-weight: 600;
    color: var(--hud-cyan);
  }

  .chevron-icon {
    transition: transform var(--transition-normal), color var(--transition-fast);
    opacity: 0.65;
  }

  .nav-dropdown:hover .chevron-icon,
  .nav-dropdown:focus-within .chevron-icon,
  .nav-dropdown.is-open .chevron-icon {
    transform: rotate(180deg);
    opacity: 1;
    color: var(--hud-cyan);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 200px;
    padding: 0.45rem;
    background: rgba(13, 18, 31, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.8), 0 0 25px rgba(56, 189, 248, 0.12);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.2s;
    z-index: 1010;
  }

  /* Invisible bridge to prevent mouse leave gap */
  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu,
  .nav-dropdown.is-open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }

  .dropdown-item:hover {
    color: var(--text-primary);
    background: rgba(56, 189, 248, 0.1);
  }

  .dropdown-item.active {
    color: var(--hud-cyan);
    font-weight: 600;
    background: rgba(56, 189, 248, 0.08);
  }

  .dropdown-item .external-icon {
    opacity: 0.6;
    transition: transform var(--transition-fast), opacity var(--transition-fast), color var(--transition-fast);
  }

  .dropdown-item:hover .external-icon {
    opacity: 1;
    color: var(--hud-cyan);
    transform: translate(1px, -1px);
  }

  .external-icon {
    opacity: 0.6;
    margin-left: 2px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .github-link {
    color: var(--text-secondary);
    padding: 0.4rem;
    display: flex;
    align-items: center;
    transition: color var(--transition-fast);
  }

  .github-link:hover {
    color: var(--text-primary);
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
  }

  /* Mobile Menu Styles */
  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--card-border);
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-link {
    padding: 0.85rem 0;
    font-size: 1.05rem;
    color: var(--text-primary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    text-decoration: none;
  }

  .mobile-link.active {
    color: var(--hud-cyan);
    font-weight: 600;
  }

  .mobile-group {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-group-toggle {
    width: 100%;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 0;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
    font-family: inherit;
    cursor: pointer;
  }

  .mobile-group.open .mobile-group-toggle {
    color: var(--hud-cyan);
  }

  .mobile-group.open .mobile-group-toggle .chevron-icon {
    transform: rotate(180deg);
    color: var(--hud-cyan);
    opacity: 1;
  }

  .mobile-group-items {
    display: none;
    flex-direction: column;
    padding-left: 0.85rem;
    padding-bottom: 0.6rem;
    gap: 0.25rem;
  }

  .mobile-group.open .mobile-group-items {
    display: flex;
  }

  .mobile-sublink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
  }

  .mobile-sublink:hover,
  .mobile-sublink.active {
    color: var(--hud-cyan);
  }

  .mobile-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 860px) {
    .nav-links, .nav-actions {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('active');
  });

  const links = mobileMenu?.querySelectorAll('a');
  links?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('active');
    });
  });

  // Mobile accordion toggle
  const mobileGroupToggles = mobileMenu?.querySelectorAll('.mobile-group-toggle');
  mobileGroupToggles?.forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.mobile-group');
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      group?.classList.toggle('open');
    });
  });

  // Desktop dropdown accessibility & click support
  const navDropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');
  navDropdowns.forEach(dropdown => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('.dropdown-trigger');
    
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdown.classList.contains('is-open');
      navDropdowns.forEach(d => {
        if (d !== dropdown) {
          d.classList.remove('is-open');
          d.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
      dropdown.classList.toggle('is-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // Close dropdowns on outside click or Escape
  document.addEventListener('click', (e) => {
    navDropdowns.forEach(dropdown => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.classList.remove('is-open');
        dropdown.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      navDropdowns.forEach(dropdown => {
        dropdown.classList.remove('is-open');
        dropdown.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>
